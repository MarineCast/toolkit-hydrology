# Copy to .env in this toolkit folder. No parent-directory search.
# Precedence: explicit CLI/API or JSON config > process environment > this file.
# DATA_DIR is the current per-river product; file-relative paths resolve here.
DATA_DIR=../../Data/Hydrology
START_DATE=2009-01-01
END_DATE=2026-10-15
VERBOSITY=True

# Run `hydrology preflight` before acquisition.
# Recompute commands use the entire retained product, regardless of acquisition dates.
# Legacy release output (--output) and source cache (--cache) remain separate.
